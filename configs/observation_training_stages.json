    {"id": "S1-observation-encoder", "gradient": true, "primary_target": "ERA5 analysis", "deployment_equivalent": false},
    {"id": "S2-observation-space", "gradient": true, "primary_target": "withheld future observations", "deployment_equivalent": true},
    {"id": "S3-cycling", "gradient": true, "primary_target": "future observations after cycling", "deployment_equivalent": true},
    {"id": "S4-independent-validation", "gradient": false, "primary_target": "unseen observations; ERA5 secondary", "deployment_equivalent": true}
  ]
}
