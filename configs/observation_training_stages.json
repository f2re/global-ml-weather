{
  "schema": "observation-training-policy-1",
  "era5": {
    "role": "separate_frozen_model_verification_only",
    "allowed_training": false,
    "allowed_operational_input": false,
    "allowed_stages": [
      "S4-independent-validation"
    ]
  },
  "observations": {
    "station_identifier_required": false,
    "required_metadata": [
      "source",
      "variable",
      "observed_at",
      "available_at",
      "latitude",
      "longitude",
      "units"
    ],
    "upper_air_additional_metadata": [
      "pressure_pa"
    ],
    "identity_preference": [
      "provider_message_id",
      "profile_id",
      "platform_id",
      "coordinate_time_fallback"
    ],
    "actual_level_time_and_position_preferred": true
  },
  "stages": [
    {
      "id": "S0-theory",
      "gradient": true,
      "primary_target": "explicit synthetic software fixture",
      "deployment_equivalent": false
    },
    {
      "id": "S1-observation-encoder",
      "gradient": true,
      "primary_target": "withheld real observations",
      "deployment_equivalent": false
    },
    {
      "id": "S2-observation-space",
      "gradient": true,
      "primary_target": "withheld future observations",
      "deployment_equivalent": true
    },
    {
      "id": "S3-cycling",
      "gradient": true,
      "primary_target": "future observations after cycling",
      "deployment_equivalent": true
    },
    {
      "id": "S4-independent-validation",
      "gradient": false,
      "primary_target": "unseen observations; ERA5 secondary",
      "deployment_equivalent": true
    }
  ],
  "satellite_stages": [
    {
      "stage_id": "S1_ru_sat_radiometric_warmup",
      "freeze_forecast_core": true,
      "mesh_level": "mesh3",
      "epochs": 8,
      "active_instruments": ["elektro_l_msugs", "arktika_m_msugs", "meteor_m_ikfs2_clear"],
      "train_modules": ["multimodal_encoder", "sparse_observation_encoder", "varbc"],
      "learning_rate": 3e-4
    },
    {
      "stage_id": "S2_joint_clearsky_and_amv",
      "freeze_forecast_core": false,
      "mesh_level": "mesh8",
      "epochs": 15,
      "active_instruments": ["elektro_l_msugs", "arktika_m_msugs", "meteor_m_ikfs2_above_cloud", "meteor_m_mtvza_upper", "msugs_amv"],
      "hydrostatic_loss_weight": 1.0,
      "sat_assimilation_loss_weight": 0.25,
      "learning_rate": 1e-4
    },
    {
      "stage_id": "S3_allsky_microwave_and_arctic_ice",
      "freeze_forecast_core": false,
      "mesh_level": "mesh8",
      "epochs": 15,
      "active_instruments": ["elektro_l_msugs", "arktika_m_msugs", "meteor_m_ikfs2_above_cloud", "meteor_m_mtvza_allsky", "meteor_m_brlk_ice", "msugs_amv"],
      "hydrostatic_loss_weight": 1.0,
      "sat_assimilation_loss_weight": 0.5,
      "learning_rate": 5e-5
    }
  ]
}
